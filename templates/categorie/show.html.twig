{% extends 'base.html.twig' %}

{% block title %}Categorie{% endblock %}

{% block body %}
    <h1 class="text-center">Categorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ categorie.id }}</td>
            </tr>
            <tr>
                <th>NomCat</th>
                <td>{{ categorie.nomCat }}</td>
            </tr>
            <tr>
                <th>AgeCat</th>
                <td>{{ categorie.ageCat }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_categorie_index') }}">back to list</a>

    <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">edit</a>
    {{ include('categorie/_delete_form.html.twig') }}

    <h1 class="text-center">Liste adherent par categorie</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>NomJ</th>
                <th>Prenom</th>
                <th>DateNaissJ</th>
                <th>Categorie</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for adherent in categorie.adherents %}
            <tr>
                <td>{{ adherent.id }}</td>
                <td>{{ adherent.nomJ }}</td>
                <td>{{ adherent.prenom }}</td>
                <td>{{ adherent.dateNaissJ ? adherent.dateNaissJ|date('d-m-Y') : '' }}</td>
                <td>{{adherent.categorie.nomCat}}</td>
                <td>
                    <a href="{{ path('app_adherent_show', {'id': adherent.id}) }}">show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
