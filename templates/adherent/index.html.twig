{% extends 'base.html.twig' %}

{% block title %}Adherent{% endblock %}

{% block body %}
    <h1 class="text-center">Adherent</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>NomJ</th>
                <th>Prenom</th>
                <th>DateNaissJ</th>
                <th>Categorie</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for adherent in adherents %}
            <tr>
                <td>{{ adherent.id }}</td>
                <td>{{ adherent.nomJ }}</td>
                <td>{{ adherent.prenom }}</td>
                <td>{{ adherent.dateNaissJ ? adherent.dateNaissJ|date('d-m-Y') : '' }}</td>
                <td>{{adherent.categorie.nomCat}}</td>
                <td>
                    <a href="{{ path('app_adherent_show', {'id': adherent.id}) }}">show</a>
                    <a href="{{ path('app_adherent_edit', {'id': adherent.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_adherent_new') }}">Create new</a>
{% endblock %}
