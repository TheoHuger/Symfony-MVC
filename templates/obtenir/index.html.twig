{% extends 'base.html.twig' %}

{% block title %}Obtenir index{% endblock %}

{% block body %}
    <h1>Obtenir index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateObtention</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for obtenir in obtenirs %}
            <tr>
                <td>{{ obtenir.id }}</td>
                <td>{{ obtenir.dateObtention ? obtenir.dateObtention|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_obtenir_show', {'id': obtenir.id}) }}">show</a>
                    <a href="{{ path('app_obtenir_edit', {'id': obtenir.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_obtenir_new') }}">Create new</a>
{% endblock %}
