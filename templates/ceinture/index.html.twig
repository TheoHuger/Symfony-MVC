{% extends 'base.html.twig' %}

{% block title %}Ceinture index{% endblock %}

{% block body %}
    <h1>Ceinture index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>CouleurC</th>
                <th>AgeC</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ceinture in ceintures %}
            <tr>
                <td>{{ ceinture.id }}</td>
                <td>{{ ceinture.couleurC }}</td>
                <td>{{ ceinture.ageC }}</td>
                <td>
                    <a href="{{ path('app_ceinture_show', {'id': ceinture.id}) }}">show</a>
                    <a href="{{ path('app_ceinture_edit', {'id': ceinture.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ceinture_new') }}">Create new</a>
{% endblock %}
