{% extends 'base.html.twig' %}

{% block title %}Adherent{% endblock %}

{% block body %}
    <h1 class="text-center">Adherent</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ adherent.id }}</td>
            </tr>
            <tr>
                <th>NomJ</th>
                <td>{{ adherent.nomJ }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ adherent.prenom }}</td>
            </tr>
            <tr>
                <th>DateNaissJ</th>
                <td>{{ adherent.dateNaissJ ? adherent.dateNaissJ|date('d-m-Y') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_adherent_index') }}">back to list</a>

    <a href="{{ path('app_adherent_edit', {'id': adherent.id}) }}">edit</a>

    <table class="table">
        <thead>
            <tr>
                <th>Ceinture</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
        {% for obtenir in adherent.obtenirs %}
            <tr>
                <td>{{ obtenir.idC.CouleurC }}</td>
                <td>{{ obtenir.dateObtention|date('d/m/Y') }}</td>

            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ include('adherent/_delete_form.html.twig') }}
{% endblock %}
